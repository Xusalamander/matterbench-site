    "steps": [
      {
        "name": "画图案",
        "chat": [
          ["me", "我想做一朵会转、还会发光的花。"],
          ["ai", "好,先在拼豆面板上画花。我画了一版,你看看。"]
        ],
        "do": { "panel": "draft" }
      },
      {
        "name": "改颜色",
        "chat": [
          ["me", "花心想要黄色,中间带点橙。"],
          ["ai", "改好了:红花瓣、黄橙花心、绿茎叶,共 74 颗豆。"]
        ],
        "do": { "panel": "final" }
      },
      {
        "name": "搭转动座",
        "chat": [
          ["me", "怎么让它转起来?"],
          ["ai", "立一根圆棒当轴,套两个卡扣,再装一根扁条,就是转动座。"]
        ],
        "do": { "show": [1, 2, 3, 0] }
      },
      {
        "name": "装上去",
        "chat": [
          ["ai", "把花熨成一片,夹进连接座,插到转动座上。"],
          ["me", "装好了!"]
        ],
        "do": { "show": [4] }
      },
      {
        "name": "点亮",
        "chat": [
          ["me", "再让它亮起来。"],
          ["ai", "在花后面放一盏 8×8 灯板,光会透过每颗豆。"]
        ],
        "do": { "show": [5], "light": true }
      },
      {
        "name": "转一转",
        "chat": [
          ["ai", "检查过了:转一整圈不会碰到灯。拨一下试试。"],
          ["me", "它转起来了,还在发光!"]
        ],
        "do": { "spin": true }
      }
    ]
